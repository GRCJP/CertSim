{
  "name": "certsim",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "description": "CertSim — a modular certification-exam simulator engine with adaptive study modes and an offline Kindle study pack",
  "author": "GRCJP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GRCJP/certsim.git"
  },
  "keywords": [
    "exam",
    "quiz",
    "assessment",
    "preparation",
    "test",
    "simulator",
    "spaced-repetition",
    "kindle",
    "epub",
    "offline-study"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "predev": "node scripts/generate-kindle-pack.mjs",
    "dev": "vite",
    "kindle": "node scripts/generate-kindle-pack.mjs",
    "test:kindle": "node scripts/test-kindle-pack.mjs",
    "prebuild": "node scripts/generate-kindle-pack.mjs",
    "build": "vite build",
    "build:github": "npm ci --production=false && npm run build",
    "lint": "eslint src --max-warnings=0",
    "test:unit": "node src/utils/scenarioUtils.test.js",
    "test": "npm run kindle && npm run test:kindle && npm run test:unit",
    "preview": "vite preview",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.4.0",
    "@supabase/supabase-js": "^2.90.1",
    "lucide-react": "^0.560.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.13",
    "terser": "^5.44.0",
    "vite": "^7.2.4"
  }
}
